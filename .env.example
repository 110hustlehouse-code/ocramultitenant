# ─── Database ────────────────────────────────────────────────
# In Codespaces il Postgres del devcontainer risponde su localhost.
DATABASE_URL="postgresql://ocra:ocra@localhost:5432/ocra"

# ─── Auth.js ─────────────────────────────────────────────────
# Genera con: openssl rand -base64 32   (post-create lo fa da solo)
AUTH_SECRET=""
# Necessario dietro proxy (Codespaces, Vercel, VPS con Caddy)
AUTH_TRUST_HOST="true"

# Google OAuth (Google Cloud Console → Credenziali → ID client OAuth)
# Redirect URI: https://<dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Accesso di sviluppo senza password: SOLO in locale/Codespaces.
# In produzione è ignorato anche se "true".
AUTH_DEV_LOGIN="true"

# ─── Seed ────────────────────────────────────────────────────
# La tua email Google: il seed la crea come CEO per provare il login vero.
SEED_OWNER_EMAIL=""

# ─── Verbali ─────────────────────────────────────────────────
# Claude: scrive il verbale ed estrae i task (console.anthropic.com)
ANTHROPIC_API_KEY=""
# Deepgram: trascrizione dell'audio delle riunioni (console.deepgram.com)
DEEPGRAM_API_KEY=""

# ─── Archivio file: Cloudflare R2 ────────────────────────────
# Audio delle riunioni (e in seguito i documenti). Il bucket deve avere la CORS
# che permette PUT dal dominio dell'app (vedi docs/SVILUPPO.md).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""

R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ocra-files"

# ─── Richiami via email (Google Workspace) ───────────────────
# Account Workspace dedicato (es. ocra@fulcrolucem.com) con verifica in due passaggi
# e una «password per le app» (myaccount.google.com/apppasswords).
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="OCRA <ocra@fulcrolucem.com>"
# Segreto per l'endpoint /api/cron/richiami (chiamato ogni ora). openssl rand -hex 32
CRON_SECRET=""
APP_URL="http://localhost:3000"
