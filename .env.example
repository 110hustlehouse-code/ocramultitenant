# ─── Database ────────────────────────────────────────────────
# In Codespaces il Postgres del devcontainer risponde su localhost.
DATABASE_URL="postgresql://ocra:ocra@localhost:5432/ocra"

# ─── Auth.js ─────────────────────────────────────────────────
# Genera con: openssl rand -base64 32   (post-create lo fa da solo)
AUTH_SECRET=""
# Necessario dietro proxy (Codespaces, Vercel, VPS con Caddy)
AUTH_TRUST_HOST="true"

# Google OAuth (Google Cloud Console → Credenziali → ID client OAuth)
# Redirect URI: https://<dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Accesso di sviluppo senza password: SOLO in locale/Codespaces.
# In produzione è ignorato anche se "true".
AUTH_DEV_LOGIN="true"

# ─── Seed ────────────────────────────────────────────────────
# La tua email Google: il seed la crea come CEO per provare il login vero.
SEED_OWNER_EMAIL=""
