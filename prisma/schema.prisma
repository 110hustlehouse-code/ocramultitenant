// ─────────────────────────────────────────────────────────────
// OCRA — schema dati
// Regole:
//  • ogni modello di dominio ha tenantId (vedi src/server/db/tenant.ts)
//  • ogni modifica = nuova migrazione (npm run db:migrate)
//  • branding, moduli, listini vivono qui, mai nel codice
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: "url"/"directUrl" qui non sono più supportati (vanno in prisma.config.ts).
  // DATABASE_URL (pooler, runtime) e DIRECT_URL (diretta, migrazioni) sono spiegate lì.
}

/// Cosa l'utente può fare IN UNA SOCIETÀ (vedi Membership).
/// La stessa persona può essere PM di Fulcro e creativo in Duit.
enum Role {
  CEO
  PROJECT_MANAGER
  CREATIVE
  EXTERNAL
}

/// Moduli attivabili per tenant (ordine = ordine di costruzione).
enum ModuleKey {
  ANAGRAFICHE
  PROGETTI
  VERBALI
  RICHIAMO
  SOLLECITI
  DOCUMENTI
  MARGINE
  PREVENTIVI
  COLLABORATORI
}

/// Cliente di OCRA (es. il gruppo di Daniele Masini).
model Tenant {
  id        String      @id @default(cuid())
  slug      String      @unique
  name      String
  /// Dominio dedicato, es. ocra.fulcrolucem.it
  domain    String?     @unique
  modules   ModuleKey[] @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  companies               Company[]
  users                   User[]
  memberships             Membership[]
  parties                 Party[]
  partyCompanies          PartyCompany[]
  projects                Project[]
  projectMembers          ProjectMember[]
  tasks                   Task[]
  meetings                Meeting[]
  meetingIntegrations     MeetingIntegration[]
  clientFollowUps         ClientFollowUp[]
  clientMessages          ClientMessage[]
  serviceItems            ServiceItem[]
  quotes                  Quote[]
  quoteLines              QuoteLine[]
  projectBudgetLines      ProjectBudgetLine[]
  projectCosts            ProjectCost[]
  reminders               Reminder[]
  accountBlocks           AccountBlock[]
  documents               Document[]
  collaboratorEvaluations CollaboratorEvaluation[]
  passwordResetTokens     PasswordResetToken[]
}

/// Società del tenant (Fulcro, Duit, St'Art). Porta il branding.
model Company {
  id                  String   @id @default(cuid())
  tenantId            String
  slug                String
  name                String
  legalName           String?
  vatNumber           String?
  /// Colore brand per tema chiaro (hex)
  colorLight          String
  /// Colore brand per tema scuro (hex)
  colorDark           String
  logoUrl             String?
  /// Sfondo della tessera logo (hex), per loghi pensati su fondo pieno
  logoBg              String?
  /// Dati giuridici: servono per intestazioni, preventivi e PO
  pec                 String?
  sdiCode             String?
  reaNumber           String?
  legalAddress        String?
  legalRepresentative String?
  /// Acronimo usato nei codici PO (es. FL, DT)
  poPrefix            String?
  /// Dati bancari: mostrati nel piè di pagina del preventivo
  bankIban            String?
  bankAccountHolder   String?
  /// Preventivi: prossimo numero (progressivo per società, continuo negli anni)
  nextQuoteNumber     Int      @default(1)
  /// Condizioni predefinite (es. «50% alla firma, saldo alla consegna»)
  quoteTerms          String?
  quoteValidityDays   Int      @default(30)
  /// Piè di pagina del preventivo (IBAN, note)
  quoteFooter         String?
  /// Il PDF del preventivo usa colorLight/colorDark su bordi, etichette e totale.
  /// A false resta in inchiostro neutro (es. Duit, St'Art: nessun accento colore nei documenti reali).
  pdfAccent           Boolean  @default(true)
  sortOrder           Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships             Membership[]
  parties                 PartyCompany[]
  projects                Project[]
  meetings                Meeting[]
  meetingIntegrations     MeetingIntegration[]
  serviceItems            ServiceItem[]
  quotes                  Quote[]
  collaboratorEvaluations CollaboratorEvaluation[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  name            String
  /// Numero WhatsApp in formato E.164 — canale principale delle notifiche
  phone           String?
  active          Boolean   @default(true)
  /// Solo per EXTERNAL: dopo questa data l'accesso è negato
  accessExpiresAt DateTime?
  lastLoginAt     DateTime?
  /// Login con password (accanto a Google OAuth): null = nessun login con password configurato
  passwordHash         String?
  /// Password assegnata dal CEO: true finché non la cambia, blocca ogni pagina tranne il cambio password
  mustChangePassword   Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  /// Login con password negato finché non passa questa data (brute-force sullo stesso account)
  lockedUntil          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant                      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships                 Membership[]
  passwordResetTokens         PasswordResetToken[]
  managedProjects             Project[]                @relation("ProjectManager")
  projectMembers              ProjectMember[]
  assignedTasks               Task[]                   @relation("TaskAssignee")
  completedTasks              Task[]                   @relation("TaskCompletedBy")
  meetings                    Meeting[]
  meetingIntegrations         MeetingIntegration[]
  followUpsStarted            ClientFollowUp[]         @relation("FollowUpStartedBy")
  followUpsResolved           ClientFollowUp[]         @relation("FollowUpResolvedBy")
  clientMessagesSent          ClientMessage[]
  quotesCreated               Quote[]
  projectCostsCreated         ProjectCost[]
  reminders                   Reminder[]               @relation("ReminderRecipient")
  blocks                      AccountBlock[]           @relation("BlockedUser")
  blocksIssued                AccountBlock[]           @relation("BlockedBy")
  documentsUploaded           Document[]               @relation("DocumentUploadedBy")
  documentsApproved           Document[]               @relation("DocumentApprovedBy")
  /// Scheda collaboratore collegata, se questo utente ha anche una riga Party (rubrica)
  collaboratorParty           Party?
  collaboratorEvaluationsMade CollaboratorEvaluation[]

  @@unique([tenantId, email])
  @@index([email])
}

/// Accesso di una persona a una società, con il ruolo che ha LÌ.
/// Nessuna riga = la società non è visibile. Il team resta condiviso:
/// un collaboratore ha una riga per ogni società in cui lavora.
model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  companyId String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([tenantId])
  @@index([companyId])
}

/// Token monouso per "password dimenticata". Si salva solo l'hash: il token in chiaro
/// vive solo nel link mandato per email, mai nel DB (stesso pattern dei token dei Verbali).
model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

enum PartyKind {
  CLIENTE
  FORNITORE
  /// Persona fisica con collaborazione continuativa (categoria di spesa, processo 19 Contabilità)
  COLLABORATORE_INTERNO
  /// Freelance, consulente, partner creativo (categoria di spesa, processo 19 Contabilità)
  COLLABORATORE_ESTERNO
}

/// Tipo di documento emesso dal collaboratore/fornitore per i pagamenti.
enum FiscalDocumentType {
  FATTURA
  NOTULA
  /// Cessione di diritti d'autore con ritenuta d'acconto (tipico per creativi/artisti)
  CESSIONE_DIRITTI_RITENUTA
  ALTRO
}

/// Anagrafica: cliente, fornitore o collaboratore del gruppo.
/// Stessa struttura per tutti (richiesta di Daniele, 28 set). Le persone fisiche
/// (artisti, collaboratori) hanno il codice fiscale al posto della P.IVA.
///
/// `kinds` è un array, non un valore solo: la STESSA persona/società può essere allo stesso
/// tempo, es., fornitore e collaboratore esterno — un'unica riga, due ruoli. Non è un caso
/// ipotetico: nei dati reali 11 anagrafiche esistono già duplicate come righe CLIENTE +
/// FORNITORE separate con lo stesso CF/P.IVA (migrazione `*_collaboratori`); non vengono
/// fuse automaticamente qui — è un'pulizia dati a parte, deliberata, non in questa modifica.
model Party {
  id                 String              @id @default(cuid())
  tenantId           String
  kinds              PartyKind[]
  /// Ragione sociale, o nome e cognome per le persone fisiche
  name               String
  vatNumber          String?
  taxCode            String?
  pec                String?
  sdiCode            String?
  /// Indirizzo per l'intestazione del preventivo (via, CAP, città); compare solo se presente
  address            String?
  /// Referente: nome, email e cellulare
  contactName        String?
  email              String?
  phone              String?
  /// Categorie merceologiche / ruolo-competenze per i collaboratori (es. "Videomaker"), al massimo 3
  categories         String[]            @default([])
  /// Sigla per il codice PO (es. TEATRONUOVO); se manca si ricava dal nome
  shortCode          String?
  /// Solo collaboratori/fornitori: disponibilità indicativa (es. "3 giorni/settimana")
  availabilityNote   String?
  /// Dati di pagamento — visibili solo con finance:read, stesso pattern di Company.bankIban
  paymentIban        String?
  paymentHolder      String?
  fiscalDocumentType FiscalDocumentType?
  /// Testo libero, come Company.quoteTerms (es. "Entro il 5 del mese successivo" / "60 giorni data fattura")
  paymentTerms       String?
  /// Collaboratore con accesso all'app: collegamento opzionale 1:1, mai obbligatorio
  linkedUserId       String?             @unique
  notes              String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedUser  User?                    @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  companies   PartyCompany[]
  projects    Project[]
  followUps   ClientFollowUp[]
  quotes      Quote[]
  costs       ProjectCost[]
  evaluations CollaboratorEvaluation[]

  @@index([tenantId])
}

/// Società di riferimento di un'anagrafica (può lavorare con più società del gruppo).
model PartyCompany {
  tenantId  String
  partyId   String
  companyId String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party   Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([partyId, companyId])
  @@index([tenantId])
  @@index([companyId])
}

enum ProjectStatus {
  ATTIVO
  IN_PAUSA
  CHIUSO
  ANNULLATO
}

/// Pochi stati apposta: un task o è da fare o è fatto (con la prova). Niente «in corso» da aggiornare.
enum TaskStatus {
  DA_FARE
  FATTO
}

enum TaskPriority {
  NORMALE
  ALTA
  URGENTE
}

/// Da dove nasce il task: a mano oppure estratto da un verbale (modulo Verbali).
enum TaskSource {
  MANUALE
  VERBALE
}

/// Progetto (commessa) di una società del gruppo.
model Project {
  id        String        @id @default(cuid())
  tenantId  String
  companyId String
  /// Cliente finale; vuoto per i progetti interni
  clientId  String?
  name      String
  /// Codice PO (es. FL/COMUNIC/01-2026/CLIENTE/E)
  code      String?
  /// Servizio apportato (dal listino della società)
  service   String?
  status    ProjectStatus @default(ATTIVO)
  startDate DateTime?
  dueDate   DateTime?
  /// Project manager responsabile
  managerId String?
  notes     String?
  closedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client                  Party?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager                 User?                    @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members                 ProjectMember[]
  tasks                   Task[]
  meetings                Meeting[]
  meetingIntegrations     MeetingIntegration[]
  followUps               ClientFollowUp[]
  documents               Document[]
  quote                   Quote?
  budgetLines             ProjectBudgetLine[]
  costs                   ProjectCost[]
  collaboratorEvaluations CollaboratorEvaluation[]

  @@unique([tenantId, code])
  @@index([tenantId, companyId, status])
  @@index([clientId])
}

/// Chi lavora sul progetto. Collaboratori ed esterni vedono solo i progetti in cui sono qui.
model ProjectMember {
  tenantId  String
  projectId String
  userId    String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Task {
  id             String       @id @default(cuid())
  tenantId       String
  projectId      String
  title          String
  description    String?
  assigneeId     String?
  dueDate        DateTime?
  priority       TaskPriority @default(NORMALE)
  status         TaskStatus   @default(DA_FARE)
  source         TaskSource   @default(MANUALE)
  /// Prova di chiusura: link al file consegnato o nota breve (principio 1)
  proof          String?
  /// Verbale da cui è stato estratto (source = VERBALE)
  meetingId      String?
  /// Riga di budget a cui contribuisce: il Margine stima il lavoro interno da qui, non dalle ore
  budgetLineId   String?
  /// Richiamo: 0 nessuno · 1 primo (mattina) · 2 secondo (pomeriggio) · 3 al PM · 4 al CEO
  escalation     Int          @default(0)
  lastReminderAt DateTime?
  /// «Non posso, perché…»: ferma i richiami automatici e porta il motivo al PM
  blockerNote    String?
  blockerAt      DateTime?
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy User?              @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  meeting     Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  budgetLine  ProjectBudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  reminders   Reminder[]
  blocks      AccountBlock[]
  followUps   ClientFollowUp[]
  documents   Document[]

  @@index([tenantId, projectId])
  @@index([meetingId])
  @@index([tenantId, assigneeId, status])
  @@index([budgetLineId])
}

enum DocumentStatus {
  IN_LAVORAZIONE
  APPROVATO
}

/// File di progetto su R2 (stessa infrastruttura degli audio dei Verbali). Più caricamenti
/// con lo stesso nome file nello stesso progetto (`groupKey`) sono versioni successive:
/// non si sovrascrive mai nulla su R2, lo storico resta consultabile (principio: i sorgenti si conservano).
model Document {
  id           String         @id @default(cuid())
  tenantId     String
  projectId    String
  /// Valorizzato solo se questo file è la prova di chiusura di quel task
  taskId       String?
  /// Nome del file così come caricato
  originalName String
  /// Nome canonico generato dal sistema: Progetto_TipoFile_Versione_Data
  displayName  String
  /// Chiave di raggruppamento delle versioni: nome file normalizzato dentro il progetto
  groupKey     String
  version      Int            @default(1)
  status       DocumentStatus @default(IN_LAVORAZIONE)
  /// Oggetto su R2
  key          String
  mimeType     String
  size         Int
  uploadedById String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy User?   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  approvedBy User?   @relation("DocumentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, groupKey])
  @@index([tenantId, projectId, originalName])
  @@index([taskId])
}

enum MeetingStatus {
  /// Creato, in attesa di audio o trascrizione
  BOZZA
  /// Trascrizione e verbale in corso
  IN_ELABORAZIONE
  /// Verbale e task proposti pronti da rivedere
  DA_RIVEDERE
  /// Task confermati e creati
  CONFERMATO
  ERRORE
}

/// Da dove arriva la riunione. Cambia solo l'ingresso: dopo, il flusso è uno solo.
enum MeetingSource {
  /// Registrata in app con il tasto «ascolto»
  REGISTRAZIONE
  /// File audio caricato (Meet, Zoom, telefono…)
  AUDIO
  /// Trascrizione già fatta altrove, incollata o caricata come testo
  TESTO
  /// Inviata da un servizio esterno (Fireflies, n8n…) tramite collegamento
  WEBHOOK
}

/// Riunione: audio → trascrizione → verbale → task proposti → confermati dal PM.
model Meeting {
  id            String         @id @default(cuid())
  tenantId      String
  companyId     String
  /// Riunione di un progetto (i task proposti vanno lì per default)
  projectId     String?
  title         String
  heldAt        DateTime
  /// Oggetto su R2 con l'audio originale
  audioKey      String?
  durationSec   Int?
  transcript    String?
  /// Verbale in markdown: partecipanti, punti, decisioni
  minutes       String?
  /// Task proposti dall'AI, da confermare (JSON validato con zod)
  proposals     Json?
  status        MeetingStatus  @default(BOZZA)
  /// Vuoto finché non arriva audio o testo
  source        MeetingSource?
  /// Collegamento che l'ha inviata (solo WEBHOOK)
  integrationId String?
  /// Id della riunione nel servizio esterno: lo stesso invio ripetuto non crea doppioni
  externalId    String?
  error         String?
  createdById   String?
  confirmedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  integration MeetingIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@unique([integrationId, externalId])
  @@index([tenantId, companyId, heldAt])
  @@index([projectId])
}

/// Collegamento con un servizio di trascrizione esterno. Autentica con un token di servizio
/// (non una sessione utente); nel DB c'è solo l'hash. Decide società e progetto predefinito.
model MeetingIntegration {
  id          String    @id @default(cuid())
  tenantId    String
  companyId   String
  /// Nome per riconoscerlo, es. «Fireflies Erika»
  name        String
  /// Progetto in cui vanno le riunioni, se il collegamento è per un solo progetto
  projectId   String?
  /// SHA-256 del token (il token in chiaro si vede solo alla creazione)
  tokenHash   String    @unique
  /// Ultime 4 cifre, per riconoscerlo in elenco
  tokenHint   String
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  meetings  Meeting[]

  @@index([tenantId, companyId])
}

enum ReminderChannel {
  EMAIL
}

enum ReminderKind {
  /// Automatico al collaboratore (livelli 1 e 2)
  AUTOMATICO
  /// Il task passa al PM (livello 3)
  AL_PM
  /// Richiamo manuale del PM al collaboratore (in UI «Richiamo del PM»; non è un sollecito al cliente)
  SOLLECITO
  /// Passato al CEO (livello 4)
  AL_CEO
  /// «Non posso»: avviso al PM
  NON_POSSO
}

/// Registro di ogni richiamo: chi, quando, perché. Serve anche a non inviare doppioni.
model Reminder {
  id          String          @id @default(cuid())
  tenantId    String
  taskId      String
  recipientId String
  kind        ReminderKind
  level       Int
  channel     ReminderChannel @default(EMAIL)
  /// Inviato davvero (false = canale non configurato o errore)
  delivered   Boolean         @default(false)
  error       String?
  createdAt   DateTime        @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient User   @relation("ReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([taskId])
}

/// Blocco dell'account deciso da PM o CEO: il collaboratore vede solo il task da consegnare.
/// Mai automatico. Si chiude da solo quando il task viene consegnato.
model AccountBlock {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  taskId      String
  blockedById String
  reason      String?
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  blockedBy User   @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, releasedAt])
  @@index([taskId])
}

enum FollowUpStatus {
  /// Si aspetta il cliente
  ATTIVO
  /// Il cliente ha risposto o consegnato (o il task è stato chiuso)
  RISOLTO
  /// Aperto per errore o non più necessario
  ANNULLATO
}

enum ClientMessageKind {
  PRIMO
  PROMEMORIA
}

/// Sollecito: un task è fermo in attesa di un cliente esterno. Lo avvia una persona, mai il sistema;
/// il sistema manda solo i promemoria dopo N giorni lavorativi di silenzio (docs/piani/SOLLECITI.md).
model ClientFollowUp {
  id                String         @id @default(cuid())
  tenantId          String
  taskId            String
  /// Ridondante con task.projectId: la vista per progetto e il margine non passano dal task
  projectId         String
  partyId           String?
  /// Referente al momento dell'avvio: se l'anagrafica cambia, il thread resta coerente
  contactName       String?
  contactEmail      String
  /// Cosa si aspetta dal cliente, scritto da chi lo avvia
  waitingFor        String
  status            FollowUpStatus @default(ATTIVO)
  startedById       String
  startedAt         DateTime       @default(now())
  /// Promemoria automatici: ogni quanti giorni lavorativi, fino a quanti
  everyWorkdays     Int            @default(3)
  maxReminders      Int            @default(2)
  remindersSent     Int            @default(0)
  /// Prossimo promemoria; null = nessuno in programma
  nextReminderAt    DateTime?
  /// Tetto raggiunto: il PM è stato avvisato (una volta sola)
  managerNotifiedAt DateTime?
  resolvedAt        DateTime?
  resolvedById      String?
  resolutionNote    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  party      Party?          @relation(fields: [partyId], references: [id], onDelete: SetNull)
  startedBy  User            @relation("FollowUpStartedBy", fields: [startedById], references: [id], onDelete: Cascade)
  resolvedBy User?           @relation("FollowUpResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  messages   ClientMessage[]

  @@index([tenantId, status, nextReminderAt])
  @@index([projectId, status])
  @@index([taskId])
}

/// Ogni messaggio inviato al cliente, con il testo esatto.
model ClientMessage {
  id         String            @id @default(cuid())
  tenantId   String
  followUpId String
  kind       ClientMessageKind
  channel    ReminderChannel   @default(EMAIL)
  to         String
  subject    String
  body       String
  /// Message-ID dell'email: i promemoria rispondono nello stesso thread
  messageId  String?
  /// null = promemoria automatico
  sentById   String?
  delivered  Boolean           @default(false)
  error      String?
  createdAt  DateTime          @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  followUp ClientFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  sentBy   User?          @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([followUpId])
}

/// Listino della società: da qui si compongono i preventivi (anche con Claude). Nel DB, mai nel codice.
model ServiceItem {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  name        String
  description String?
  /// Segmento SERVIZIO del codice PO (es. EVENTI, BRAND, COMUNIC)
  poCode      String
  /// forfait, giorno, ora, pezzo…
  unit        String   @default("forfait")
  /// Prezzo di listino per unità, in centesimi
  unitPrice   Int
  /// Costo interno previsto per unità, in centesimi (solo CEO): base del budget del Margine
  unitCost    Int?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteLines  QuoteLine[]
  budgetLines ProjectBudgetLine[]

  @@index([tenantId, companyId, active])
}

enum QuoteStatus {
  BOZZA
  INVIATO
  ACCETTATO
  RIFIUTATO
}

/// Preventivo. Accettato → nasce il progetto, con le voci come budget (docs/piani/PREVENTIVI.md).
model Quote {
  id                String      @id @default(cuid())
  tenantId          String
  companyId         String
  clientId          String
  /// Progressivo per società, continuo negli anni (Fulcro riparte da 30)
  number            Int
  title             String
  status            QuoteStatus @default(BOZZA)
  issueDate         DateTime
  validUntil        DateTime?
  intro             String?
  terms             String?
  /// Aliquota IVA predefinita per le nuove righe, in percentuale (ogni riga può avere la propria:
  /// il "Riepilogo IVA" nel PDF raggruppa per aliquota effettiva, come nei preventivi reali)
  vatRate           Int         @default(22)
  /// Importi in centesimi, ricalcolati dal server a ogni salvataggio
  subtotal          Int         @default(0)
  vat               Int         @default(0)
  total             Int         @default(0)
  /// Il brief da cui Claude ha proposto le voci
  brief             String?
  sentAt            DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  rejectionNote     String?
  /// Passi dopo l'accettazione: si segnano, non bloccano
  contractSignedAt  DateTime?
  depositReceivedAt DateTime?
  /// Progetto creato all'accettazione
  projectId         String?     @unique
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client    Party       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines     QuoteLine[]

  @@unique([companyId, number])
  @@index([tenantId, companyId, status])
}

/// Voce del preventivo: copia della voce di listino (il preventivo non cambia se cambia il listino).
model QuoteLine {
  id              String   @id @default(cuid())
  tenantId        String
  quoteId         String
  /// null = voce fuori listino
  serviceItemId   String?
  description     String
  quantity        Decimal  @db.Decimal(10, 2)
  unit            String
  /// Centesimi
  unitPrice       Int
  /// Percentuale (0-100); null = nessuno sconto. Mai proposto dall'AI, lo aggiunge il CEO.
  discountPercent Decimal? @db.Decimal(5, 2)
  /// Aliquota IVA di questa riga (di norma quella del preventivo al momento della creazione)
  vatRate         Int
  total           Int
  /// Costo previsto (interno, mai nel PDF), in centesimi: diventa il costo di budget
  plannedCost     Int?
  sortOrder       Int      @default(0)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote       Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem?       @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  budgetLine  ProjectBudgetLine?

  @@index([quoteId])
}

/// Budget del progetto: nasce dalle voci del preventivo accettato, poi vive da solo (varianti, extra).
/// Il Margine confronterà i costi reali con queste righe.
model ProjectBudgetLine {
  id            String   @id @default(cuid())
  tenantId      String
  projectId     String
  /// Voce del preventivo da cui nasce (null = aggiunta dopo)
  quoteLineId   String?  @unique
  serviceItemId String?
  description   String
  /// Ricavo previsto, centesimi
  revenue       Int
  /// Costo previsto, centesimi
  plannedCost   Int?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteLine   QuoteLine?    @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  serviceItem ServiceItem?  @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  tasks       Task[]
  costs       ProjectCost[]

  @@index([projectId])
}

/// Costo reale, registrato a mano (fattura, collaboratore esterno, acquisto): il Margine lo
/// confronta con `ProjectBudgetLine.plannedCost`. Niente ore: «in soldi e in task» (priorità di Daniele).
model ProjectCost {
  id           String   @id @default(cuid())
  tenantId     String
  projectId    String
  /// Riga di budget a cui imputarlo (facoltativo: una spesa può non mappare una voce precisa)
  budgetLineId String?
  /// A chi è stato pagato (collaboratore o fornitore), se registrato in rubrica
  partyId      String?
  description  String
  /// Centesimi
  amount       Int
  incurredAt   DateTime
  createdById  String?
  createdAt    DateTime @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine ProjectBudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  party      Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId])
  @@index([budgetLineId])
  @@index([partyId])
}

/// Scheda di valutazione di un collaboratore, di norma a fine collaborazione su un progetto.
model CollaboratorEvaluation {
  id            String   @id @default(cuid())
  tenantId      String
  partyId       String
  companyId     String
  projectId     String?
  /// 1-5
  rating        Int
  notes         String?
  evaluatedById String?
  createdAt     DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  evaluatedBy User?    @relation(fields: [evaluatedById], references: [id], onDelete: SetNull)

  @@index([tenantId, partyId])
  @@index([companyId])
}
