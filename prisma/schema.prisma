// ─────────────────────────────────────────────────────────────
// OCRA — schema dati
// Regole:
//  • ogni modello di dominio ha tenantId (vedi src/server/db/tenant.ts)
//  • ogni modifica = nuova migrazione (npm run db:migrate)
//  • branding, moduli, listini vivono qui, mai nel codice
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Cosa l'utente può fare IN UNA SOCIETÀ (vedi Membership).
/// La stessa persona può essere PM di Fulcro e creativo in Duit.
enum Role {
  CEO
  PROJECT_MANAGER
  CREATIVE
  EXTERNAL
}

/// Moduli attivabili per tenant (ordine = ordine di costruzione).
enum ModuleKey {
  ANAGRAFICHE
  PROGETTI
  VERBALI
  RICHIAMO
  DOCUMENTI
  MARGINE
  PREVENTIVI
}

/// Cliente di OCRA (es. il gruppo di Daniele Masini).
model Tenant {
  id        String      @id @default(cuid())
  slug      String      @unique
  name      String
  /// Dominio dedicato, es. ocra.fulcrolucem.it
  domain    String?     @unique
  modules   ModuleKey[] @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  companies      Company[]
  users          User[]
  memberships    Membership[]
  parties        Party[]
  partyCompanies PartyCompany[]
}

/// Società del tenant (Fulcro, Duit, St'Art). Porta il branding.
model Company {
  id                  String   @id @default(cuid())
  tenantId            String
  slug                String
  name                String
  legalName           String?
  vatNumber           String?
  /// Colore brand per tema chiaro (hex)
  colorLight          String
  /// Colore brand per tema scuro (hex)
  colorDark           String
  logoUrl             String?
  /// Sfondo della tessera logo (hex), per loghi pensati su fondo pieno
  logoBg              String?
  /// Dati giuridici: servono per intestazioni, preventivi e PO
  pec                 String?
  sdiCode             String?
  reaNumber           String?
  legalAddress        String?
  legalRepresentative String?
  /// Acronimo usato nei codici PO (es. FL, DT)
  poPrefix            String?
  sortOrder           Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  parties     PartyCompany[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  name            String
  /// Numero WhatsApp in formato E.164 — canale principale delle notifiche
  phone           String?
  active          Boolean   @default(true)
  /// Solo per EXTERNAL: dopo questa data l'accesso è negato
  accessExpiresAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, email])
  @@index([email])
}

/// Accesso di una persona a una società, con il ruolo che ha LÌ.
/// Nessuna riga = la società non è visibile. Il team resta condiviso:
/// un collaboratore ha una riga per ogni società in cui lavora.
model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  companyId String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([tenantId])
  @@index([companyId])
}

enum PartyKind {
  CLIENTE
  FORNITORE
}

/// Anagrafica: un cliente o un fornitore del gruppo.
/// Stessa struttura per entrambi (richiesta di Daniele, 28 set). Le persone fisiche
/// (artisti, collaboratori) hanno il codice fiscale al posto della P.IVA.
model Party {
  id          String    @id @default(cuid())
  tenantId    String
  kind        PartyKind
  /// Ragione sociale, o nome e cognome per le persone fisiche
  name        String
  vatNumber   String?
  taxCode     String?
  pec         String?
  sdiCode     String?
  /// Referente: nome, email e cellulare
  contactName String?
  email       String?
  phone       String?
  /// Categorie merceologiche, al massimo 3
  categories  String[]  @default([])
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companies PartyCompany[]

  @@unique([tenantId, kind, vatNumber])
  @@index([tenantId, kind])
}

/// Società di riferimento di un'anagrafica (può lavorare con più società del gruppo).
model PartyCompany {
  tenantId  String
  partyId   String
  companyId String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party   Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([partyId, companyId])
  @@index([tenantId])
  @@index([companyId])
}
